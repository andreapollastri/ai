APP_NAME=TryGeorge
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# auto | transformers | fake
GEORGE_ENGINE=auto
# sync | queue
GEORGE_DRIVER=sync
GEORGE_MODEL=onnx-community/deberta-v3-large-zeroshot-v2.0-ONNX
GEORGE_MODEL_B=Xenova/nli-deberta-v3-large
GEORGE_ENSEMBLE=true
# Slot C: an instruct LLM read through next-token logits over the option letters
GEORGE_REASONER=true
# onnx  → TransformersPHP in-process, no extra service, caps out at 4B
# llama → llama-server over HTTP, takes 8B/14B GGUF, needs the unit running
GEORGE_REASONER_BACKEND=onnx
GEORGE_REASONER_DEBIAS=true

# --- onnx backend ---
# Needs a q4 or int8 ONNX build: the PHP ONNX binding cannot read q4f16.
GEORGE_REASONER_MODEL=onnx-community/Qwen3-4B-Instruct-2507-ONNX
GEORGE_REASONER_FILE=model_q4
# chatml (Qwen3 thinking) | chatml_plain (Qwen2.5, Qwen3 Instruct) | phi3 | llama3
GEORGE_REASONER_FORMAT=chatml_plain

# --- llama backend ---
# llama-server downloads the GGUF itself from `-hf REPO:QUANT`.
GEORGE_LLAMA_URL=http://127.0.0.1:8080
GEORGE_LLAMA_REPO=Qwen/Qwen3-8B-GGUF
GEORGE_LLAMA_QUANT=Q4_K_M
GEORGE_LLAMA_FORMAT=chatml
GEORGE_LLAMA_N_PROBS=40
GEORGE_LLAMA_CACHE_PROMPT=true
GEORGE_LLAMA_TIMEOUT=120
# Slot weights, normalised over the slots that are running
GEORGE_WEIGHT_A=0.25
GEORGE_WEIGHT_B=0.15
GEORGE_WEIGHT_C=0.60
GEORGE_QUANTIZED=true
GEORGE_TEMPERATURE=1.0
GEORGE_JOB_TIMEOUT=180
